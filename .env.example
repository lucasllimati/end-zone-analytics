# Porta da API (Fastify)
API_PORT=8787
# Host de bind. Use 0.0.0.0 em container.
HOST=127.0.0.1
# Token da área administrativa (/admin). Login gera sessão em cookie HttpOnly; também aceito como
# "Authorization: Bearer" em automações. Em produção é OBRIGATÓRIO para usar o admin
# (fora de produção, o acesso a partir de localhost é liberado sem token). Gere com: openssl rand -hex 32
ADMIN_TOKEN=
# Diretório privado do log operacional (execuções, alertas, auditoria). Nunca servido publicamente.
# OPS_DIR=./ops
# Recomendado: token do GitHub (sem permissões) — 5.000 consultas/h em vez de 60/h por IP. Evita HTTP 403 em cargas seguidas.
GITHUB_TOKEN=
# Primeira temporada carregada pelo pipeline (nflverse cobre 1999+).
FIRST_SEASON=1999

# ---------------------------------------------------------------------------
# Produção (docker compose)
# ---------------------------------------------------------------------------
# Domínio público (ex.: endzone.duckdns.org). O Caddy emite o certificado HTTPS automaticamente.
DOMAIN=
# E-mail para avisos do Let's Encrypt (opcional, recomendado).
ACME_EMAIL=

# Cargas automáticas (agendador interno; aparecem no /admin como "Agendada").
# Parcial (incremental) a cada N horas; 0 desliga.
SYNC_PARTIAL_EVERY_HOURS=6
# Carga completa semanal: dia (0 = domingo … 6 = sábado) e hora em UTC. Deixe vazio para desligar.
SYNC_FULL_WEEKDAY=2
SYNC_FULL_HOUR_UTC=7

# Alertas no celular/chat quando algo falhar (opcional).
# ntfy (grátis, sem cadastro): https://ntfy.sh/<um-nome-dificil-de-adivinhar>
# Discord: URL de webhook do canal · Slack: URL de Incoming Webhook
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=ntfy
# Severidade mínima enviada: info | warning | error | critical
ALERT_MIN_SEVERITY=warning
