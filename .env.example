# Porta da API (Fastify)
API_PORT=8787
# Host de bind. Use 0.0.0.0 em container.
HOST=127.0.0.1
# Token da área administrativa (/admin). Login gera sessão em cookie HttpOnly; também aceito como
# "Authorization: Bearer" em automações. Em produção é OBRIGATÓRIO para usar o admin
# (fora de produção, o acesso a partir de localhost é liberado sem token). Gere com: openssl rand -hex 32
ADMIN_TOKEN=
# Diretório privado do log operacional (execuções, alertas, auditoria). Nunca servido publicamente.
# OPS_DIR=./ops
# Recomendado: token do GitHub (sem permissões) — 5.000 consultas/h em vez de 60/h por IP. Evita HTTP 403 em cargas seguidas.
GITHUB_TOKEN=
# Primeira temporada carregada pelo pipeline (nflverse cobre 1999+).
FIRST_SEASON=1999
