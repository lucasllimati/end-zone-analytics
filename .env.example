# Porta da API (Fastify)
API_PORT=8787
# Host de bind. Use 0.0.0.0 em container.
HOST=127.0.0.1
# Token exigido para POST /api/admin/sync quando a requisição NÃO vem de localhost.
# Deixe vazio para permitir sincronização apenas a partir da própria máquina.
ADMIN_TOKEN=
# Opcional: token do GitHub para aumentar o limite de verificações de atualização (60/h sem token).
GITHUB_TOKEN=
# Primeira temporada carregada pelo pipeline (nflverse cobre 1999+).
FIRST_SEASON=1999
